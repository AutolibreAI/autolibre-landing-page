# ── Backend de AutoLibre ─────────────────────────────────────────────────────
# A donde manda /api/provider las solicitudes de partner, y de donde /proveedores
# lee el catalogo de servicios al renderizar. Sin NEXT_PUBLIC_ a proposito: solo
# la usan el servidor y las rutas de API, no tiene por que viajar al bundle.
# Si falta, el alta de proveedores falla con un mensaje explicito al arrancar la
# request — no en silencio — y el formulario se sirve con el aviso de que no se
# pudo cargar el listado de servicios.
AUTOLIBRE_API_URL=http://localhost:3005

# ── Blog (Hygraph CMS) ───────────────────────────────────────────────────────
# Content API URL: Project settings > Endpoints. Server-side, sin NEXT_PUBLIC_.
# Si falta, /blog se sirve vacío (con log) en vez de romper el build.
HYGRAPH_ENDPOINT=
# Permanent Auth Token con permiso de lectura. Opcional: solo si la Content API
# no tiene habilitada la lectura pública del stage Published.
# El pipeline del blog (`npm run blog:roundtrip`) lo usa con lectura del stage
# DRAFT; sin token, el roundtrip queda "no automatizado" (se compara a mano).
HYGRAPH_TOKEN=
# Secreto compartido con el webhook de Hygraph que apunta a /api/revalidate
# (header `x-revalidate-secret`). Generar con: openssl rand -hex 32
HYGRAPH_REVALIDATE_SECRET=

# ── Pipeline del blog: imágenes (Nano Banana / Gemini) ───────────────────────
# API key de Gemini para `npm run blog:image` (scripts/blog/generate-image.ts).
# Es uso pago: sin key, el script sale con exit 2 y el pipeline frena en imágenes.
NANOBANANA_API_KEY=
# Opcional: modelo de imagen (default gemini-3.1-flash-image). También se puede
# pasar con --model; `npm run blog:image -- --list-models` lista los disponibles.
NANOBANANA_MODEL=

# ── Formulario de soporte (Resend) ───────────────────────────────────────────
RESEND_API_KEY=
SUPPORT_EMAIL_FROM="AutoLibre Soporte <team@support.autolibre.ai>"
SUPPORT_EMAIL_TO=

# ── SEO ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

CLASIFIC_API_KEY=
CLASIFIC_API_BASE_URL=


NEXT_PUBLIC_META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=